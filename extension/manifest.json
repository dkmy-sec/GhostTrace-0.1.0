{
  "manifest_version": 3,
  "name": "GhostTrace",
  "version": "0.1.0",
  "description": "Visualize browser destinations and tracker evidence in your local GhostTrace dashboard.",
  "minimum_chrome_version": "120",
  "permissions": ["webRequest", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "GhostTrace"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "incognito": "not_allowed"
}
